<UserControl x:Class="POSSEDQI.Controls.ProductCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:POSSEDQI.Controls"
             xmlns:helpers="clr-namespace:POSSEDQI.Helpers"
             x:Name="root"
             mc:Ignorable="d" 
             Width="220" Height="280">

    <!-- استخدام Border بدلاً من Button للتحكم الكامل -->
    <Border Background="#FFF5F5F5" CornerRadius="12" 
            BorderThickness="1" BorderBrush="#FFE0E0E0"
            Padding="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- صورة المنتج -->
            <Border CornerRadius="8" ClipToBounds="True" Margin="8">
                <Image Source="{Binding ImagePath, FallbackValue='/Assets/placeholder.png'}" 
                       Stretch="UniformToFill"/>

                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.6"/>
                        <GradientStop Color="#20000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- معلومات المنتج -->
            <StackPanel Grid.Row="1" Margin="8,0,8,8">
                <TextBlock Text="{Binding Name}" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="#FF333333"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="40"/>

                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="#FF666666"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Description, Converter={helpers:StringToVisibilityConverter}}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{Binding Quantity, Converter={helpers:QuantityToColorConverter}}"
                            CornerRadius="4"
                            Padding="4,2">
                        <TextBlock Text="{Binding Quantity, StringFormat='المتبقي: {0}'}"
                                   FontSize="12"
                                   Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}'}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF2E7D32"/>
                        <TextBlock Text=" MAD"
                                   FontSize="12"
                                   Foreground="#FF2E7D32"
                                   Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- زر غير مرئي للتأثيرات -->
            <Button Style="{StaticResource ModernButtonStyle}"
                    Command="{Binding DataContext.ShowProductDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    Opacity="0"/>
        </Grid>
    </Border>
</UserControl>