<UserControl x:Class="POSSEDQI.Controls.ProductCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="220" Height="280"
             xmlns:local="clr-namespace:POSSEDQI.Controls"
             x:Name="root">

    <Border Background="#FFF5F5F5" CornerRadius="12" 
            BorderThickness="1" BorderBrush="#FFE0E0E0"
            Padding="8" Effect="{StaticResource CardShadow}">

        <Button Style="{StaticResource FlatButtonStyle}" 
                Command="{Binding ClickCommand}"
                Padding="0">

            <Grid>
                <!-- الصورة مع طبقة تدرج لوني -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- صورة المنتج -->
                <Border CornerRadius="8" ClipToBounds="True">
                    <Image Source="{Binding CurrentProduct.ImagePath}" 
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- طبقة تدرج لوني -->
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" Offset="0.6"/>
                            <GradientStop Color="#20000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- المعلومات النصية -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <!-- الاسم -->
                    <TextBlock Text="{Binding CurrentProduct.Name}" 
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#FF333333" TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" Height="Auto" MaxHeight="40"/>

                    <!-- الوصف (إن وجد) -->
                    <TextBlock Text="{Binding CurrentProduct.Description}"
                               FontSize="12" Foreground="#FF666666"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" Height="Auto" MaxHeight="40"
                               Visibility="{Binding CurrentProduct.Description, 
                               Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- السعر والكمية -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- الكمية -->
                        <Border Background="#FFE3F2FD" CornerRadius="4"
                                Padding="4,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CurrentProduct.Quantity, StringFormat='{}المتبقي: {0}'}"
                                       FontSize="12" Foreground="#FF0D47A1"/>
                        </Border>

                        <!-- السعر -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentProduct.Price, StringFormat='{}{0:N2}'}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#FF2E7D32"/>
                            <TextBlock Text=" MAD" 
                                       FontSize="12" Foreground="#FF2E7D32"
                                       Margin="2,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- مؤشر اللمس (للواجهات التفاعلية) -->
                <Border x:Name="TouchIndicator" Opacity="0"
                         Background="#10000000" CornerRadius="12"/>
            </Grid>
        </Button>
    </Border>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Button.PreviewTouchDown">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TouchIndicator"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.3" Duration="0:0:0.1"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="Button.TouchLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TouchIndicator"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>