<UserControl x:Class="POSSEDQI.Views.InventoryView"
             xmlns:views="clr-namespace:POSSEDQI.Views"
             xmlns:vm="clr-namespace:POSSEDQI.ViewModels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:POSSEDQI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#0f172a">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- البحث والأزرار -->
            <RowDefinition Height="*"/>
            <!-- المنتجات -->
        </Grid.RowDefinitions>

        <!-- شريط البحث والتحكم (بقي كما هو تماماً) -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 5" VerticalAlignment="Top">
            <!-- مربع البحث -->
            <TextBox x:Name="SearchBox" Width="200" Height="32" Margin="0,0,10,0" Padding="5" VerticalContentAlignment="Center"
                     Text="... ابحث عن" HorizontalContentAlignment="Right" Foreground="Gray"
                     GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" FontSize="14"/>

            <!-- فلترة حسب الفئة -->
            <ComboBox Width="200" Height="32" Margin="0,0,115,0" Padding="5" FontSize="16"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Right">
                <ComboBoxItem Content="كل الفئات" IsSelected="True" FontSize="16"/>
                <ComboBoxItem Content="فئة 1"/>
                <ComboBoxItem Content="فئة 2"/>
            </ComboBox>

            <!-- أزرار التحكم -->
            <Button Command="{Binding OpenAddProductCommand}" Width="100" Height="32" Margin="0,0,100,0" Background="Green"  
                    Foreground="White" ToolTip="إضافة منتج إلى المخزون">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="إضافة " VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Image Source="/Icons/add.png" Width="20" Height="20" />
                </StackPanel>
            </Button>
            <Button Width="100" Height="32" Margin="0,0,100,0" Background="Red" Foreground="White" ToolTip="حذف منتج من المخزون">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="حذف" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Image Source="/Icons/delete.png" Width="20" Height="20" />
                </StackPanel>
            </Button>
            <Button Width="90" Height="32" Margin="0,0,100,0" Background="Orange" Foreground="White">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="تعديل" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Image Source="/Icons/edit.png" Width="20" Height="20" />
                </StackPanel>
            </Button>

            <Button Width="150" Height="32" Margin="0,0,10,0" Background="#0285c7" Foreground="White">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="طباعة الكتالوج" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Image Source="/Icons/print.png" Width="20" Height="20" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- منطقة عرض المنتجات المعدلة فقط -->
        <!-- منطقة عرض المنتجات المعدلة -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Products}" Margin="0 20 0 0">
                <!-- 1. تنظيم البطاقات في شبكة مرنة -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- 2. تحسين المسافات بين البطاقات -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="15" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <!-- 3. ربط كل عنصر بقالب البطاقة -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ProductCardControl 
                            Width="220"
                            Height="280"
                            Product="{Binding}"
                            Margin="10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>